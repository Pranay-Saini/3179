{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 480,
  "title": {
    "text": "The Continental Footprint of Australian Playgrounds (n = 2,239)",
    "subtitle": "Spatial distribution across Australian states by urban classification (Click legend to highlight cohort)",
    "font": "Merriweather",
    "fontSize": 16,
    "fontWeight": "bold",
    "color": "#1E293B",
    "subtitleFont": "Plus Jakarta Sans",
    "subtitleFontSize": 12,
    "subtitleColor": "#475569",
    "anchor": "start",
    "offset": 12
  },
  "projection": {
    "type": "equirectangular",
    "center": [134, -28.5],
    "scale": 760
  },
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {"type": "geoshape", "fill": "#E0F2FE"}
    },
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {"type": "topojson", "feature": "States"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1F5F9",
        "stroke": "#CBD5E1",
        "strokeWidth": 1
      }
    },
    {
      "data": {"url": "data/osm_playgrounds_clean.csv"},
      "params": [
        {
          "name": "cohort_highlight",
          "select": {"type": "point", "fields": ["Urban_Cohort"]},
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 36,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.4
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "color": {
          "field": "Urban_Cohort",
          "type": "nominal",
          "title": "Geographic Cohort",
          "scale": {
            "domain": ["Metropolitan", "Regional & Rural"],
            "range": ["#2166AC", "#B2182B"]
          },
          "legend": {
            "orient": "top-right",
            "fillColor": "#FFFFFF",
            "strokeColor": "#CBD5E1",
            "cornerRadius": 6,
            "padding": 14,
            "rowPadding": 8,
            "titleFont": "Plus Jakarta Sans",
            "titleFontSize": 14,
            "titleFontWeight": "bold",
            "titleColor": "#1E293B",
            "labelFont": "Plus Jakarta Sans",
            "labelFontSize": 13,
            "labelColor": "#1E293B",
            "symbolSize": 260,
            "symbolOpacity": 0.95
          }
        },
        "opacity": {
          "condition": {"param": "cohort_highlight", "value": 0.78},
          "value": 0.1
        },
        "tooltip": [
          {"field": "meta_name_sub", "type": "nominal", "title": "Suburb"},
          {"field": "meta_name_area", "type": "nominal", "title": "Council (LGA)"},
          {"field": "meta_name_state", "type": "nominal", "title": "State"},
          {"field": "Urban_Cohort", "type": "nominal", "title": "Cohort"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 151.5,
            "lat": -33.8,
            "note": "Eastern Seaboard Concentration:;VIC, NSW, & QLD comprise 80.1%;of documented national sites."
          }
        ]
      },
      "transform": [{"calculate": "split(datum.note, ';')", "as": "note_lines"}],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "dy": -8,
        "font": "Plus Jakarta Sans",
        "fontSize": 11.5,
        "fontWeight": "bold",
        "color": "#1E293B"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "note_lines"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}