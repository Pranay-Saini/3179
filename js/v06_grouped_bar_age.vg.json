{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 350,
  "title": {
    "text": "Normalized Playground Surface Composition Across States (%)",
    "subtitle": "Within-state percentage share of audited playgrounds by ground surface material (Click legend to filter)",
    "font": "Merriweather",
    "fontSize": 16,
    "fontWeight": "bold",
    "color": "#1E293B",
    "subtitleFont": "Plus Jakarta Sans",
    "subtitleFontSize": 12,
    "subtitleColor": "#475569",
    "anchor": "start",
    "offset": 12
  },
  "data": {"url": "data/osm_playgrounds_clean.csv"},
  "params": [
    {
      "name": "surf_select",
      "select": {"type": "point", "fields": ["Surface_Clean"]},
      "bind": "legend"
    }
  ],
  "transform": [
    {"filter": "datum.Surface_Clean != 'Unrecorded'"},
    {
      "joinaggregate": [{"op": "count", "as": "State_Total"}],
      "groupby": ["State_Abbr"]
    },
    {
      "aggregate": [
        {"op": "count", "as": "Site_Count"},
        {"op": "max", "field": "State_Total", "as": "State_Total"}
      ],
      "groupby": ["State_Abbr", "Surface_Clean"]
    },
    {
      "calculate": "(datum.Site_Count / datum.State_Total) * 100",
      "as": "State_Pct"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 3,
    "cornerRadiusTopRight": 3,
    "stroke": "#475569",
    "strokeWidth": 0.3
  },
  "encoding": {
    "x": {
      "field": "State_Abbr",
      "type": "nominal",
      "title": "Australian State / Territory",
      "sort": ["VIC", "NSW", "QLD", "WA", "SA", "TAS", "ACT", "NT"],
      "axis": {"labelAngle": 0, "labelFontWeight": "bold"}
    },
    "xOffset": {
      "field": "Surface_Clean",
      "sort": [
        "Woodchips & Bark",
        "Sand",
        "Impact Rubber",
        "Grass & Turf",
        "Earth & Gravel",
        "Concrete & Paved"
      ]
    },
    "y": {
      "field": "State_Pct",
      "type": "quantitative",
      "title": "Share of State's Audited Playgrounds (%)",
      "scale": {"domain": [0, 100]},
      "axis": {
        "grid": true,
        "gridDash": [3, 3],
        "gridColor": "#E2E8F0"
      }
    },
    "color": {
      "field": "Surface_Clean",
      "type": "nominal",
      "title": "Surface Material",
      "scale": {
        "domain": [
          "Woodchips & Bark",
          "Sand",
          "Impact Rubber",
          "Grass & Turf",
          "Earth & Gravel",
          "Concrete & Paved"
        ],
        "range": [
          "#E69F00",
          "#F0E442",
          "#009E73",
          "#CC79A7",
          "#8C564B",
          "#999999"
        ]
      },
      "legend": {
        "titleFont": "Plus Jakarta Sans",
        "titleFontSize": 12.5,
        "titleFontWeight": "bold",
        "labelFont": "Plus Jakarta Sans",
        "labelFontSize": 12,
        "symbolSize": 180,
        "rowPadding": 6
      }
    },
    "opacity": {
      "condition": {"param": "surf_select", "value": 0.95},
      "value": 0.15
    },
    "tooltip": [
      {"field": "State_Abbr", "type": "nominal", "title": "State"},
      {"field": "Surface_Clean", "type": "nominal", "title": "Surface Material"},
      {"field": "State_Pct", "type": "quantitative", "title": "Share within State (%)", "format": ".1f"},
      {"field": "Site_Count", "type": "quantitative", "title": "Audited Playgrounds"},
      {"field": "State_Total", "type": "quantitative", "title": "Total Audited in State"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelFont": "Plus Jakarta Sans",
      "labelFontSize": 11,
      "labelColor": "#475569",
      "titleFont": "Plus Jakarta Sans",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1E293B"
    }
  }
}