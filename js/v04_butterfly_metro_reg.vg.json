{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Urban-Regional Divide Across States",
    "subtitle": "Comparing mean playgrounds per active LGA (left) vs accessible park toilet co-location % (right)",
    "font": "Merriweather",
    "fontSize": 16,
    "fontWeight": "bold",
    "color": "#1E293B",
    "subtitleFont": "Plus Jakarta Sans",
    "subtitleFontSize": 12,
    "subtitleColor": "#475569",
    "anchor": "middle",
    "offset": 16
  },
  "data": {
    "url": "data/lga_seifa_clean.csv"
  },
  "params": [
    {
      "name": "Cohort_Select",
      "value": null,
      "bind": {
        "input": "select",
        "options": [null, "Metropolitan", "Regional & Rural"],
        "labels": ["All Councils", "Metropolitan Only", "Regional & Rural Only"],
        "name": "Filter Council Cohort: "
      }
    }
  ],
  "transform": [
    {"filter": "datum.Playground_Count > 0"},
    {"filter": "Cohort_Select == null || datum.Urban_Cohort == Cohort_Select"},
    {
      "aggregate": [
        {"op": "mean", "field": "Playground_Count", "as": "Mean_Playgrounds"},
        {"op": "mean", "field": "Toilet_CoLocation_Pct", "as": "Mean_Toilet_Pct"},
        {"op": "count", "as": "Active_LGA_Count"}
      ],
      "groupby": ["State_Abbr"]
    }
  ],
  "spacing": 12,
  "hconcat": [
    {
      "width": 430,
      "height": 360,
      "mark": {
        "type": "bar",
        "color": "#762A83",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "y": {
          "field": "State_Abbr",
          "type": "nominal",
          "axis": null,
          "sort": ["VIC", "NSW", "QLD", "WA", "SA", "TAS", "ACT", "NT"]
        },
        "x": {
          "field": "Mean_Playgrounds",
          "type": "quantitative",
          "title": "Mean Playgrounds / Active LGA",
          "sort": "descending",
          "axis": {
            "grid": true,
            "gridDash": [3, 3],
            "gridColor": "#E2E8F0",
            "titlePadding": 12,
            "labelPadding": 6,
            "tickSize": 4
          }
        },
        "tooltip": [
          {"field": "State_Abbr", "type": "nominal", "title": "State"},
          {"field": "Mean_Playgrounds", "type": "quantitative", "title": "Mean Playgrounds per LGA", "format": ".1f"},
          {"field": "Active_LGA_Count", "type": "quantitative", "title": "Active Councils (LGAs)"}
        ]
      }
    },
    {
      "width": 64,
      "height": 360,
      "mark": {
        "type": "text",
        "font": "Plus Jakarta Sans",
        "fontWeight": 700,
        "fontSize": 12.5,
        "color": "#1E293B",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "y": {
          "field": "State_Abbr",
          "type": "nominal",
          "axis": null,
          "sort": ["VIC", "NSW", "QLD", "WA", "SA", "TAS", "ACT", "NT"]
        },
        "text": {
          "field": "State_Abbr",
          "type": "nominal"
        }
      }
    },
    {
      "width": 430,
      "height": 360,
      "mark": {
        "type": "bar",
        "color": "#1B7837",
        "cornerRadiusEnd": 4
      },
      "encoding": {
        "y": {
          "field": "State_Abbr",
          "type": "nominal",
          "axis": null,
          "sort": ["VIC", "NSW", "QLD", "WA", "SA", "TAS", "ACT", "NT"]
        },
        "x": {
          "field": "Mean_Toilet_Pct",
          "type": "quantitative",
          "title": "Suburb Toilet Co-Location (%)",
          "scale": {"domain": [0, 100]},
          "axis": {
            "grid": true,
            "gridDash": [3, 3],
            "gridColor": "#E2E8F0",
            "titlePadding": 12,
            "labelPadding": 6,
            "tickSize": 4
          }
        },
        "tooltip": [
          {"field": "State_Abbr", "type": "nominal", "title": "State"},
          {"field": "Mean_Toilet_Pct", "type": "quantitative", "title": "Accessible Toilet Co-Location (%)", "format": ".1f"},
          {"field": "Active_LGA_Count", "type": "quantitative", "title": "Active Councils (LGAs)"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "concat": {"spacing": 12},
    "axis": {
      "labelFont": "Plus Jakarta Sans",
      "labelFontSize": 11,
      "labelColor": "#475569",
      "titleFont": "Plus Jakarta Sans",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1E293B",
      "domainColor": "#94A3B8",
      "tickColor": "#CBD5E1"
    }
  }
}