{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "The Urban-Regional Divide Across States",
    "subtitle": "Comparing mean playgrounds per LGA (left) vs accessible park toilet co-location % (right)",
    "font": "Merriweather",
    "fontSize": 16,
    "fontWeight": "bold",
    "subtitleFont": "Plus Jakarta Sans",
    "subtitleFontSize": 12,
    "subtitleColor": "#475569",
    "anchor": "middle",
    "offset": 16
  },

  "data": {
    "url": "data/lga_seifa_clean.csv"
  },

  "params": [
    {
      "name": "Cohort_Select",
      "value": null,
      "bind": {
        "input": "select",
        "options": [null, "Metropolitan", "Regional & Rural"],
        "labels": ["All Councils", "Metropolitan Only", "Regional & Rural Only"],
        "name": "Filter Council Cohort: "
      }
    }
  ],

  "transform": [
    {
      "filter": "datum.Playground_Count > 0"
    },
    {
      "filter": "Cohort_Select == null || datum.Urban_Cohort == Cohort_Select"
    }
  ],

  "spacing": 12,

  "hconcat": [
    {
      "width": 360,
      "height": 390,

      "mark": {
        "type": "bar",
        "color": "#0F766E",
        "cornerRadiusEnd": 4
      },

      "encoding": {
        "y": {
          "field": "State_Abbr",
          "type": "nominal",
          "axis": null,
          "sort": ["VIC", "NSW", "QLD", "WA", "SA", "TAS", "ACT", "NT"]
        },

        "x": {
          "aggregate": "mean",
          "field": "Playground_Count",
          "type": "quantitative",
          "title": "Mean Playgrounds / Active LGA",
          "sort": "descending",
          "axis": {
            "grid": false,
            "titlePadding": 12,
            "labelPadding": 6,
            "tickSize": 4
          }
        },

        "tooltip": [
          {
            "field": "State_Abbr",
            "type": "nominal",
            "title": "State"
          },
          {
            "aggregate": "mean",
            "field": "Playground_Count",
            "type": "quantitative",
            "title": "Mean Playgrounds per LGA",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "width": 65,
      "height": 390,

      "mark": {
        "type": "text",
        "font": "Plus Jakarta Sans",
        "fontWeight": "bold",
        "fontSize": 13,
        "color": "#1E293B",
        "align": "center"
      },

      "encoding": {
        "y": {
          "field": "State_Abbr",
          "type": "nominal",
          "axis": null,
          "sort": ["VIC", "NSW", "QLD", "WA", "SA", "TAS", "ACT", "NT"]
        },

        "text": {
          "field": "State_Abbr",
          "type": "nominal"
        }
      }
    },

    {
      "width": 360,
      "height": 390,

      "mark": {
        "type": "bar",
        "color": "#D95F02",
        "cornerRadiusEnd": 4
      },

      "encoding": {
        "y": {
          "field": "State_Abbr",
          "type": "nominal",
          "axis": null,
          "sort": ["VIC", "NSW", "QLD", "WA", "SA", "TAS", "ACT", "NT"]
        },

        "x": {
          "aggregate": "mean",
          "field": "Toilet_CoLocation_Pct",
          "type": "quantitative",
          "title": "Suburb Toilet Co-Location (%)",
          "scale": {
            "domain": [0, 100]
          },
          "axis": {
            "grid": false,
            "titlePadding": 12,
            "labelPadding": 6,
            "tickSize": 4
          }
        },

        "tooltip": [
          {
            "field": "State_Abbr",
            "type": "nominal",
            "title": "State"
          },
          {
            "aggregate": "mean",
            "field": "Toilet_CoLocation_Pct",
            "type": "quantitative",
            "title": "Accessible Toilet Co-Location (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "concat": {
      "spacing": 12
    },

    "axis": {
      "labelFont": "Plus Jakarta Sans",
      "labelFontSize": 11,
      "labelColor": "#475569",
      "titleFont": "Plus Jakarta Sans",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1E293B",
      "domainColor": "#94A3B8",
      "tickColor": "#CBD5E1"
    }
  }
}