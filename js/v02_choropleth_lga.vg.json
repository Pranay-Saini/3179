{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"top": 4, "left": 4, "right": 4, "bottom": 4},
  "title": {
    "text": "Playgrounds per 10,000 Children (Aged 0–14) by Local Government Area",
    "subtitle": "Municipal playground counts normalized by ABS child population (0–14 yrs) & SEIFA Scores (Use controls to zoom & pan)",
    "font": "Merriweather",
    "fontSize": 16,
    "fontWeight": "bold",
    "color": "#1E293B",
    "subtitleFont": "Plus Jakarta Sans",
    "subtitleFontSize": 12,
    "subtitleColor": "#475569",
    "anchor": "start",
    "offset": 10
  },
  "params": [
    {
      "name": "zoom_level",
      "value": 700,
      "bind": {
        "input": "range",
        "min": 700,
        "max": 12000,
        "step": 100,
        "name": "Map Zoom: "
      }
    },
    {
      "name": "center_to",
      "value": [133.8, -28.2],
      "bind": {
        "input": "select",
        "options": [
          [133.8, -28.2],
          [144.96, -37.81],
          [151.0, -33.85],
          [153.02, -27.47],
          [115.86, -31.95],
          [138.6, -34.92]
        ],
        "labels": [
          "Australia National View",
          "Greater Melbourne (VIC)",
          "Greater Sydney (NSW)",
          "Greater Brisbane (QLD)",
          "Greater Perth (WA)",
          "Greater Adelaide (SA)"
        ],
        "name": "Focus Region: "
      }
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": {"expr": "center_to"},
    "scale": {"expr": "zoom_level"}
  },
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {"type": "geoshape", "fill": "#E0F2FE"}
    },
    {
      "data": {
        "url": "data/aus_lga.topojson",
        "format": {"type": "topojson", "feature": "lgas"}
      },
      "transform": [
        {
          "lookup": "properties.LGA_CODE26",
          "from": {
            "data": {"url": "data/lga_seifa_clean.csv"},
            "key": "LGA Code",
            "fields": ["Playground_Count", "Score", "Decile", "Region"]
          }
        },
        {
          "lookup": "properties.LGA_CODE26",
          "from": {
            "data": {"url": "data/population_age_sex.csv"},
            "key": "LGA code",
            "fields": [
              "0–4",
              "5–9",
              "10–14",
              "0\ufffd4",
              "5\ufffd9",
              "10\ufffd14",
              "0-4",
              "5-9",
              "10-14",
              "Total persons"
            ]
          }
        },
        {
          "calculate": "isValid(datum.Playground_Count) ? toNumber(datum.Playground_Count) : 0",
          "as": "Parks_Count"
        },
        {
          "calculate": "(isValid(datum['0–4']) ? toNumber(datum['0–4']) : (isValid(datum['0\ufffd4']) ? toNumber(datum['0\ufffd4']) : (isValid(datum['0-4']) ? toNumber(datum['0-4']) : 0))) + (isValid(datum['5–9']) ? toNumber(datum['5–9']) : (isValid(datum['5\ufffd9']) ? toNumber(datum['5\ufffd9']) : (isValid(datum['5-9']) ? toNumber(datum['5-9']) : 0))) + (isValid(datum['10–14']) ? toNumber(datum['10–14']) : (isValid(datum['10\ufffd14']) ? toNumber(datum['10\ufffd14']) : (isValid(datum['10-14']) ? toNumber(datum['10-14']) : 0)))",
          "as": "Kids_Pop_0_14"
        },
        {
          "calculate": "datum.Kids_Pop_0_14 > 0 ? (datum.Parks_Count / datum.Kids_Pop_0_14) * 10000 : 0",
          "as": "Parks_Per_10k_Kids"
        },
        {
          "calculate": "isValid(datum.Score) ? datum.Score : 'N/A'",
          "as": "SEIFA_Score_Display"
        },
        {
          "calculate": "isValid(datum.Decile) ? datum.Decile : 'N/A'",
          "as": "SEIFA_Decile_Display"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.4
      },
      "encoding": {
        "color": {
          "field": "Parks_Per_10k_Kids",
          "type": "quantitative",
          "title": ["Playgrounds /", "10k Kids (0–14)"],
          "scale": {
            "type": "threshold",
            "domain": [0.1, 2, 5, 10, 20],
            "range": [
              "#E2E8F0",
              "#CCFBF1",
              "#5EEAD4",
              "#14B8A6",
              "#0F766E",
              "#115E59"
            ]
          },
          "legend": {
            "orient": "top-right",
            "offset": 10,
            "fillColor": "rgba(255, 255, 255, 0.92)",
            "strokeColor": "#CBD5E1",
            "cornerRadius": 6,
            "padding": 8,
            "gradientLength": 105,
            "gradientThickness": 10,
            "titleFont": "Plus Jakarta Sans",
            "titleFontSize": 10.5,
            "titleLineHeight": 13,
            "titleFontWeight": "bold",
            "titleColor": "#1E293B",
            "labelFont": "Plus Jakarta Sans",
            "labelFontSize": 10,
            "labelColor": "#334155"
          }
        },
        "tooltip": [
          {"field": "properties.LGA_NAME26", "type": "nominal", "title": "Council (LGA)"},
          {"field": "properties.STE_NAME26", "type": "nominal", "title": "State / Territory"},
          {"field": "Parks_Per_10k_Kids", "type": "quantitative", "title": "Playgrounds per 10k Kids (0–14)", "format": ".1f"},
          {"field": "Parks_Count", "type": "quantitative", "title": "Documented Playgrounds", "format": ","},
          {"field": "Kids_Pop_0_14", "type": "quantitative", "title": "Children Aged 0–14", "format": ","},
          {"field": "SEIFA_Score_Display", "type": "nominal", "title": "ABS SEIFA Score"},
          {"field": "SEIFA_Decile_Display", "type": "nominal", "title": "SEIFA Decile (1–10)"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 131,
            "lat": -23,
            "note": "Inland Registry Void:;253 of 547 LGAs (46.3%);record 0 playgrounds (<0.1)."
          },
          {
            "lon": 138.0,
            "lat": -39.2,
            "note": "Small-Denominator Peak:;VIC/SA rural shires exceed;20+ parks per 10k kids."
          }
        ]
      },
      "transform": [
        {"filter": "zoom_level <= 1500"},
        {"calculate": "split(datum.note, ';')", "as": "note_lines"}
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "font": "Plus Jakarta Sans",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#0F172A",
        "fill": "#0F172A"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "note_lines"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}