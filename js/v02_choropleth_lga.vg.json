{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 460,
  "title": {
    "text": "Documented Playgrounds by Local Government Area (567 LGAs)",
    "subtitle": "Municipal playground counts linked with ABS SEIFA Scores (Use controls below to zoom & pan)",
    "font": "Merriweather",
    "fontSize": 16,
    "subtitleFont": "Plus Jakarta Sans",
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "params": [
    {
      "name": "zoom_level",
      "value": 780,
      "bind": {
        "input": "range",
        "min": 700,
        "max": 12000,
        "step": 100,
        "name": "Map Zoom: "
      }
    },
    {
      "name": "center_to",
      "value": [134.0, -28.5],
      "bind": {
        "input": "select",
        "options": [
          [134.0, -28.5],
          [144.96, -37.81],
          [151.0, -33.85],
          [153.02, -27.47],
          [115.86, -31.95],
          [138.60, -34.92]
        ],
        "labels": [
          "Australia National View",
          "Greater Melbourne (VIC)",
          "Greater Sydney (NSW)",
          "Greater Brisbane (QLD)",
          "Greater Perth (WA)",
          "Greater Adelaide (SA)"
        ],
        "name": "Focus Region: "
      }
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": {"expr": "center_to"},
    "scale": {"expr": "zoom_level"}
  },
  "data": {
    "url": "../data/aus_lga.topojson",
    "format": {"type": "topojson", "feature": "lgas"}
  },
  "transform": [
    {
      "lookup": "properties.LGA_CODE26",
      "from": {
        "data": {"url": "../data/lga_seifa_clean.csv"},
        "key": "LGA Code",
        "fields": ["Playground_Count", "Score", "Decile", "Region"]
      }
    },
    {
      "calculate": "isValid(datum.Playground_Count) ? toNumber(datum.Playground_Count) : 0",
      "as": "Parks_Count"
    },
    {
      "calculate": "isValid(datum.Score) ? datum.Score : 'N/A'",
      "as": "SEIFA_Score_Display"
    },
    {
      "calculate": "isValid(datum.Decile) ? datum.Decile : 'N/A'",
      "as": "SEIFA_Decile_Display"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#FFFFFF",
    "strokeWidth": 0.4
  },
  "encoding": {
    "color": {
      "field": "Parks_Count",
      "type": "quantitative",
      "title": "Playgrounds in LGA",
      "scale": {
        "type": "threshold",
        "domain": [1, 3, 8, 20, 40],
        "range": ["#E2E8F0", "#CCFBF1", "#5EEAD4", "#14B8A6", "#0F766E", "#115E59"]
      }
    },
    "tooltip": [
      {"field": "properties.LGA_NAME26", "type": "nominal", "title": "Council (LGA)"},
      {"field": "properties.STE_NAME26", "type": "nominal", "title": "State / Territory"},
      {"field": "Parks_Count", "type": "quantitative", "title": "Documented Playgrounds", "format": ","},
      {"field": "SEIFA_Score_Display", "type": "nominal", "title": "ABS SEIFA Score"},
      {"field": "SEIFA_Decile_Display", "type": "nominal", "title": "SEIFA Decile (1–10)"}
    ]
  },
  "config": {"view": {"stroke": null}}
}