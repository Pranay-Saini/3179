{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "title": {
    "text": "Repeat Winners: Top 12 NSW Councils by Total Grant Funding",
    "subtitle": "Cumulative Everyone Can Play funding ($ AUD) and number of grants captured (2018/19–2021/22)",
    "font": "Merriweather",
    "fontSize": 16,
    "fontWeight": "bold",
    "color": "#1E293B",
    "subtitleFont": "Plus Jakarta Sans",
    "subtitleFontSize": 12,
    "subtitleColor": "#475569",
    "anchor": "start",
    "offset": 12
  },
  "data": {"url": "data/nsw_everyone_can_play_clean.csv"},
  "transform": [
    {
      "aggregate": [
        {"op": "sum", "field": "Amount", "as": "Total_Funding"},
        {"op": "count", "as": "Grant_Count"},
        {"op": "mean", "field": "Score", "as": "Mean_SEIFA"},
        {"op": "max", "field": "Decile", "as": "SEIFA_Decile"},
        {"op": "max", "field": "Council_Cohort", "as": "Council_Cohort"}
      ],
      "groupby": ["Council"]
    },
    {
      "window": [{"op": "rank", "as": "Rank"}],
      "sort": [{"field": "Total_Funding", "order": "descending"}]
    },
    {"filter": "datum.Rank <= 12"},
    {
      "calculate": "'$' + format(datum.Total_Funding / 1000, ',.0f') + 'k (' + datum.Grant_Count + ' grants)'",
      "as": "Funding_Label"
    }
  ],
  "encoding": {
    "y": {
      "field": "Council",
      "type": "nominal",
      "title": null,
      "sort": {"field": "Total_Funding", "order": "descending"},
      "axis": {
        "labelLimit": 260,
        "labelPadding": 8,
        "labelFontWeight": "bold"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3.5,
        "opacity": 0.85
      },
      "encoding": {
        "x": {
          "field": "Total_Funding",
          "type": "quantitative",
          "title": "Cumulative Grant Funding ($ AUD)",
          "scale": {"domain": [0, 1250000]},
          "axis": {
            "format": "$,.0s",
            "grid": true,
            "gridDash": [3, 3],
            "gridColor": "#E2E8F0"
          }
        },
        "color": {
          "field": "Council_Cohort",
          "type": "nominal",
          "title": "Council Cohort",
          "scale": {
            "domain": ["Metropolitan", "Regional & Rural"],
            "range": ["#2166AC", "#B2182B"]
          },
          "legend": {
            "orient": "top",
            "titleFont": "Plus Jakarta Sans",
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "labelFont": "Plus Jakarta Sans",
            "labelFontSize": 11.5,
            "symbolSize": 180
          }
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 190,
        "opacity": 1,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {"field": "Total_Funding", "type": "quantitative"},
        "color": {
          "field": "Council_Cohort",
          "type": "nominal",
          "scale": {
            "domain": ["Metropolitan", "Regional & Rural"],
            "range": ["#2166AC", "#B2182B"]
          }
        },
        "tooltip": [
          {"field": "Council", "type": "nominal", "title": "Council (LGA)"},
          {"field": "Council_Cohort", "type": "nominal", "title": "Cohort"},
          {"field": "Total_Funding", "type": "quantitative", "title": "Total Funding ($)", "format": "$,.0f"},
          {"field": "Grant_Count", "type": "quantitative", "title": "Projects Funded"},
          {"field": "SEIFA_Decile", "type": "ordinal", "title": "ABS SEIFA Decile"},
          {"field": "Mean_SEIFA", "type": "quantitative", "title": "SEIFA Score", "format": ".0f"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "font": "Plus Jakarta Sans",
        "fontSize": 10.5,
        "fontWeight": "bold",
        "color": "#1E293B"
      },
      "encoding": {
        "x": {"field": "Total_Funding", "type": "quantitative"},
        "text": {"field": "Funding_Label", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelFont": "Plus Jakarta Sans",
      "labelFontSize": 11,
      "labelColor": "#475569",
      "titleFont": "Plus Jakarta Sans",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1E293B"
    }
  }
}