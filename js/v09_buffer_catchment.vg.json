{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "title": {
    "text": "The Family Dwell-Time Barrier: National Sanitary Catchments",
    "subtitle": "Accessible Park/Reserve Toilets (buffers) vs Playgrounds across Australia (56.2% suburb co-location)",
    "font": "Merriweather",
    "fontSize": 16,
    "fontWeight": "bold",
    "color": "#1E293B",
    "subtitleFont": "Plus Jakarta Sans",
    "subtitleFontSize": 12,
    "subtitleColor": "#475569",
    "anchor": "start",
    "offset": 12
  },
  "params": [
    {
      "name": "Buffer_Radius",
      "value": 100,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 600,
        "step": 100,
        "name": "Catchment Buffer Size (m): "
      }
    },
    {
      "name": "region_view",
      "value": [134.0, -28.5],
      "bind": {
        "input": "select",
        "options": [
          [134.0, -28.5],
          [144.96, -37.81],
          [151.05, -33.84],
          [153.02, -27.47],
          [115.86, -31.95],
          [138.6, -34.92],
          [147.32, -42.88]
        ],
        "labels": [
          "Australia National Overview",
          "Greater Melbourne (VIC)",
          "Greater Sydney (NSW)",
          "Greater Brisbane (QLD)",
          "Greater Perth (WA)",
          "Greater Adelaide (SA)",
          "Greater Hobart (TAS)"
        ],
        "name": "Inspect Corridor: "
      }
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": {"expr": "region_view"},
    "scale": {"expr": "region_view[0] == 134.0 ? 780 : 28000"}
  },
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {"type": "geoshape", "fill": "#E0F2FE"}
    },
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {"type": "topojson", "feature": "States"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F8FAFC",
        "stroke": "#CBD5E1",
        "strokeWidth": 1
      }
    },
    {
      "data": {"url": "data/toilets_national_parks.csv"},
      "transform": [
        {"calculate": "(Buffer_Radius / 200) * 180", "as": "buffer_area"},
        {
          "calculate": "'Accessible Park Toilet Buffer (Catchment)'",
          "as": "Catchment_Legend"
        }
      ],
      "mark": {
        "type": "circle",
        "fillOpacity": 0.18,
        "stroke": "#009E73",
        "strokeWidth": 0.7
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "size": {"field": "buffer_area", "type": "quantitative", "scale": null},
        "color": {
          "field": "Catchment_Legend",
          "type": "nominal",
          "title": "Sanitary Co-Location & Catchment",
          "scale": {
            "domain": [
              "Served (Accessible Park Toilet in Suburb)",
              "Unserved (No Accessible Park Toilet in Suburb)",
              "Accessible Park Toilet Buffer (Catchment)"
            ],
            "range": ["#2166AC", "#B2182B", "#009E73"]
          }
        },
        "tooltip": [
          {"field": "Name", "type": "nominal", "title": "Accessible Park Toilet"},
          {"field": "Town", "type": "nominal", "title": "Suburb / Town"},
          {"field": "State", "type": "nominal", "title": "State"},
          {"field": "Amenity_Tier", "type": "nominal", "title": "Facility Tier"},
          {"field": "MLAK24", "type": "nominal", "title": "24hr MLAK Access"},
          {"field": "OpeningHours", "type": "nominal", "title": "Opening Hours"}
        ]
      }
    },
    {
      "data": {"url": "data/osm_playgrounds_clean.csv"},
      "mark": {
        "type": "circle",
        "size": 34,
        "opacity": 0.85
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "color": {
          "field": "Toilet_Catchment_Status",
          "type": "nominal",
          "title": "Sanitary Co-Location & Catchment",
          "scale": {
            "domain": [
              "Served (Accessible Park Toilet in Suburb)",
              "Unserved (No Accessible Park Toilet in Suburb)",
              "Accessible Park Toilet Buffer (Catchment)"
            ],
            "range": ["#2166AC", "#B2182B", "#009E73"]
          },
          "legend": {
            "orient": "top-right",
            "fillColor": "#FFFFFF",
            "strokeColor": "#CBD5E1",
            "cornerRadius": 6,
            "padding": 12,
            "rowPadding": 8,
            "titleFont": "Plus Jakarta Sans",
            "titleFontSize": 13,
            "titleFontWeight": "bold",
            "labelFont": "Plus Jakarta Sans",
            "labelFontSize": 11.5,
            "labelLimit": 290,
            "symbolSize": 220
          }
        },
        "tooltip": [
          {"field": "Name_Clean", "type": "nominal", "title": "Playground"},
          {"field": "meta_name_sub", "type": "nominal", "title": "Suburb"},
          {"field": "State_Abbr", "type": "nominal", "title": "State"},
          {"field": "Toilet_Catchment_Status", "type": "nominal", "title": "Sanitary Status"},
          {"field": "Accessible_Park_Toilets", "type": "quantitative", "title": "Accessible Park Toilets in Suburb"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 122,
            "lat": -27,
            "note": "National Dwell-Time Gap:;43.8% of playgrounds (981 sites);lack an accessible park toilet;within their suburb catchment."
          },
          {
            "lon": 151.8,
            "lat": -34.2,
            "note": "Capital Corridor Disparity:;Inner-metro rings are well-served,;while outer growth fringes show red voids."
          }
        ]
      },
      "transform": [
        {"filter": "region_view[0] == 134.0"},
        {"calculate": "split(datum.note, ';')", "as": "note_lines"}
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "font": "Plus Jakarta Sans",
        "fontSize": 11.5,
        "fontWeight": "bold",
        "color": "#0F172A"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "note_lines"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}