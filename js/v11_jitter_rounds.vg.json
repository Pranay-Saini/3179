{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "title": {
    "text": "The Reversal: Mean Grant Size by Cohort (2018/19–2021/22)",
    "subtitle": "Connected dot plot comparing Metropolitan vs Regional & Rural mean project funding across all 4 rounds",
    "font": "Merriweather",
    "fontSize": 16,
    "fontWeight": "bold",
    "color": "#1E293B",
    "subtitleFont": "Plus Jakarta Sans",
    "subtitleFontSize": 12,
    "subtitleColor": "#475569",
    "anchor": "start",
    "offset": 12
  },
  "data": {"url": "data/nsw_everyone_can_play_clean.csv"},
  "transform": [
    {
      "aggregate": [
        {"op": "mean", "field": "Amount", "as": "Mean_Grant"},
        {"op": "sum", "field": "Amount", "as": "Total_Grant"},
        {"op": "count", "as": "Grant_Count"}
      ],
      "groupby": ["Year", "Council_Cohort"]
    }
  ],
  "encoding": {
    "y": {
      "field": "Year",
      "type": "ordinal",
      "title": "Funding Financial Year",
      "sort": ["2018/19", "2019/20", "2020/21", "2021/22"],
      "axis": {"labelFontWeight": "bold", "labelPadding": 8}
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 5,
        "color": "#CBD5E1"
      },
      "encoding": {
        "x": {
          "aggregate": "min",
          "field": "Mean_Grant",
          "type": "quantitative",
          "title": "Mean Approved Grant per Project ($ AUD)",
          "scale": {"domain": [80000, 195000]},
          "axis": {
            "format": "$,.0f",
            "grid": true,
            "gridDash": [3, 3],
            "gridColor": "#E2E8F0"
          }
        },
        "x2": {
          "aggregate": "max",
          "field": "Mean_Grant"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 240,
        "opacity": 1,
        "stroke": "#FFFFFF",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Mean_Grant",
          "type": "quantitative"
        },
        "color": {
          "field": "Council_Cohort",
          "type": "nominal",
          "title": "Council Cohort",
          "scale": {
            "domain": ["Metropolitan", "Regional & Rural"],
            "range": ["#2166AC", "#B2182B"]
          },
          "legend": {
            "orient": "top",
            "titleFont": "Plus Jakarta Sans",
            "titleFontSize": 12,
            "titleFontWeight": "bold",
            "labelFont": "Plus Jakarta Sans",
            "labelFontSize": 11.5,
            "symbolSize": 180
          }
        },
        "tooltip": [
          {"field": "Year", "type": "ordinal", "title": "Funding Round"},
          {"field": "Council_Cohort", "type": "nominal", "title": "Cohort"},
          {"field": "Mean_Grant", "type": "quantitative", "title": "Mean Project Grant ($)", "format": "$,.0f"},
          {"field": "Total_Grant", "type": "quantitative", "title": "Total Cohort Funding ($)", "format": "$,.0f"},
          {"field": "Grant_Count", "type": "quantitative", "title": "Projects Funded"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -14,
        "font": "Plus Jakarta Sans",
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {"field": "Mean_Grant", "type": "quantitative"},
        "text": {"field": "Mean_Grant", "type": "quantitative", "format": "$,.0f"},
        "color": {
          "field": "Council_Cohort",
          "type": "nominal",
          "scale": {
            "domain": ["Metropolitan", "Regional & Rural"],
            "range": ["#2166AC", "#B2182B"]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Year": "2019/20",
            "x": 126500,
            "note": "Rounds 1–2 Regional Lead:;Higher per-site grants offset;remote delivery costs",
            "color": "#B2182B"
          },
          {
            "Year": "2021/22",
            "x": 153500,
            "note": "+$42,966 Metro Lead:;Round 4 surge (+42.6% YoY);from large co-funded parks",
            "color": "#2166AC"
          }
        ]
      },
      "transform": [{"calculate": "split(datum.note, ';')", "as": "lines"}],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "dy": -4,
        "font": "Plus Jakarta Sans",
        "fontSize": 10.5,
        "fontWeight": "bold"
      },
      "encoding": {
        "y": {"field": "Year", "type": "ordinal"},
        "x": {"field": "x", "type": "quantitative"},
        "text": {"field": "lines"},
        "color": {"field": "color", "type": "nominal", "scale": null}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelFont": "Plus Jakarta Sans",
      "labelFontSize": 11,
      "labelColor": "#475569",
      "titleFont": "Plus Jakarta Sans",
      "titleFontSize": 12,
      "titleFontWeight": "bold",
      "titleColor": "#1E293B"
    }
  }
}